# Copia este archivo como ".env" y llena tus valores reales.
# NUNCA subas el .env real a un repositorio público.

PORT=5000

# URI de tu base de datos MongoDB (Atlas o local)
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/kopi-caffee

# Cadena secreta para firmar los JWT (usa algo largo y aleatorio)
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=7d

# URL del frontend, para configurar CORS correctamente
CLIENT_URL=http://localhost:5173

# Datos para crear el primer usuario admin al correr "npm run seed"
ADMIN_NAME=Admin Kopi
ADMIN_EMAIL=admin@kopicaffee.com
ADMIN_PASSWORD=Admin123!
